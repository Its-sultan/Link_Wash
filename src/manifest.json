{
  "manifest_version": 3,
  "name": "Link Wash",
  "version": "1.0.0",
  "description": "Strip tracking junk from any link — locally, privately. Right-click to copy a clean link, or paste one into the popup.",
  "homepage_url": "https://github.com/Its-sultan/Link_Wash",

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_title": "Link Wash — clean a link",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "storage",
    "activeTab",
    "offscreen"
  ]
}
